{
  "name": {
    "en": "Washing machine",
    "nl": "Wasmachine",
    "de": "Waschmaschine"
  },
  "class": "washer",
  "capabilities": [
    "onoff",
    "homeconnect_operation_state",
    "homeconnect_door_state",
    "homeconnect_program",
    "homeconnect_selected_program",
    "homeconnect_laundry_process_phase",
    "homeconnect_program_progress",
    "homeconnect_remaining_time",
    "homeconnect_elapsed_time",
    "homeconnect_start_in_relative",
    "homeconnect_remote_start",
    "homeconnect_remote_control_active",
    "homeconnect_local_control_active",
    "homeconnect_program_count_started",
    "homeconnect_child_lock",
    "homeconnect_wash_temperature",
    "homeconnect_wash_temperature_celsius",
    "homeconnect_spin_speed",
    "homeconnect_spin_speed_rpm",
    "homeconnect_vario_perfect",
    "homeconnect_speed_perfect",
    "homeconnect_eco_perfect",
    "homeconnect_water_plus",
    "homeconnect_prewash",
    "homeconnect_rinse_plus",
    "homeconnect_less_ironing",
    "homeconnect_soak",
    "homeconnect_multiple_soak",
    "homeconnect_rinse_hold",
    "homeconnect_idos1_active",
    "homeconnect_idos2_active",
    "homeconnect_energy_forecast",
    "homeconnect_water_forecast"
  ],
  "discovery": "homeconnect-mdns",
  "images": {
    "small": "/drivers/washer/assets/images/small.png",
    "large": "/drivers/washer/assets/images/large.png"
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "title": {
          "en": "Select the washing machines to add",
          "nl": "Selecteer de wasmachines om toe te voegen",
          "de": "Wähle die Waschmaschinen aus, die hinzugefügt werden sollen"
        }
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Spin speed limit",
        "nl": "Centrifugelimiet",
        "de": "Schleuderdrehzahl-Begrenzung"
      },
      "children": [
        {
          "id": "spin_limit_enabled",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Limit spin speed",
            "nl": "Centrifugetoerental beperken",
            "de": "Schleuderdrehzahl begrenzen"
          },
          "hint": {
            "en": "When a program is selected with a higher spin speed (Auto and Max count as higher), Homey lowers it to the maximum below before the program starts. Requires Remote Control on the washer; a running program is not changed.",
            "nl": "Als een programma met een hoger toerental wordt gekozen (Auto en Max tellen als hoger), verlaagt Homey het naar het maximum hieronder voordat het programma start. Vereist Remote Control op de wasmachine; een lopend programma wordt niet gewijzigd.",
            "de": "Wird ein Programm mit höherer Schleuderdrehzahl gewählt (Auto und Max gelten als höher), senkt Homey sie vor dem Start auf das Maximum unten. Erfordert Remote Control an der Waschmaschine; ein laufendes Programm wird nicht geändert."
          }
        },
        {
          "id": "spin_limit_rpm",
          "type": "dropdown",
